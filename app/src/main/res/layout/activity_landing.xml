<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".LandingActivity">

    <!-- Header Section -->
    <androidx.cardview.widget.CardView
        android:id="@+id/avatar_card"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="2dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/visionary"
            android:contentDescription="@string/logo_desc" />
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:id="@+id/greeting_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="@id/avatar_card"
        app:layout_constraintStart_toEndOf="@id/avatar_card"
        app:layout_constraintTop_toTopOf="@id/avatar_card">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/greeting_morning"
            android:textColor="#666666"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/user_name_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="James Davidson"
            android:textColor="@color/brand_dark_teal"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btn_logout"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_logout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:contentDescription="Logout"
        app:tint="@color/brand_dark_teal" />

    <!-- Search Section -->
    <LinearLayout
        android:id="@+id/search_container"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/search_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/avatar_card">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_search"
            android:contentDescription="@null"
            app:tint="@color/brand_medium_teal" />

        <EditText
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/search_hint"
            android:textColor="#212529"
            android:textColorHint="#999999"
            android:textSize="16sp"
            android:inputType="text"
            android:importantForAutofill="no" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_filter"
            android:contentDescription="@null"
            app:tint="@color/brand_dark_teal" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/main_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toTopOf="@+id/bottom_navigation_bar"
        app:layout_constraintTop_toBottomOf="@id/search_container">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Promo Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@color/brand_dark_teal"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:padding="24dp">

                    <LinearLayout
                        android:id="@+id/promo_text_container"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/promo_icon_container"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/promo_title"
                            android:textColor="#A0FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/promo_content"
                            android:textColor="#FFFFFF"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/btn_buy_now"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            app:cornerRadius="8dp"
                            app:strokeColor="#FFFFFF" />
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/promo_icon_container"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:background="@drawable/circle_white_alpha"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_gravity="center"
                            android:src="@drawable/visionary"
                            android:contentDescription="@null" />
                    </FrameLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Categories -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/category_bg_selected"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="10dp"
                        android:text="@string/cat_all"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/category_bg"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="10dp"
                        android:text="@string/cat_sun"
                        android:textColor="#666666" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/category_bg"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="10dp"
                        android:text="@string/cat_optical"
                        android:textColor="#666666" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/category_bg"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="10dp"
                        android:text="@string/cat_blue_light"
                        android:textColor="#666666" />
                </LinearLayout>
            </HorizontalScrollView>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/select_services_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_select_services"
                    android:textColor="@color/brand_dark_teal"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/see_all_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_see_all"
                    android:textColor="@color/brand_medium_teal"
                    android:textSize="14sp"
                    app:layout_constraintBottom_toBottomOf="@+id/select_services_label"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/select_services_label" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Original Content Re-styled for Light Theme -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_select_frame"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="#F8F9FA"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E0E0E0">
                    <LinearLayout android:orientation="horizontal" android:padding="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                         <ImageView android:layout_width="60dp" android:layout_height="60dp" android:src="@drawable/glass" android:scaleType="centerInside" android:contentDescription="@null" />
                         <LinearLayout android:orientation="vertical" android:layout_marginStart="16dp" android:layout_width="wrap_content" android:layout_height="wrap_content">
                             <TextView android:text="@string/title_select_frame" android:textColor="@color/brand_dark_teal" android:textSize="16sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                             <TextView android:text="@string/subtitle_select_frame" android:textColor="#666666" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                         </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_upload_report"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="#F8F9FA"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E0E0E0">
                    <LinearLayout android:orientation="horizontal" android:padding="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                        <ImageView android:layout_width="60dp" android:layout_height="60dp" android:src="@drawable/report" android:scaleType="centerInside" android:contentDescription="@null" />
                        <LinearLayout android:orientation="vertical" android:layout_marginStart="16dp" android:layout_width="wrap_content" android:layout_height="wrap_content">
                            <TextView android:text="@string/title_upload_report" android:textColor="@color/brand_dark_teal" android:textSize="16sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                            <TextView android:text="@string/subtitle_upload_report" android:textColor="#666666" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_virtual_tryon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="#F8F9FA"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E0E0E0">
                    <LinearLayout android:orientation="horizontal" android:padding="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                        <FrameLayout android:layout_width="60dp" android:layout_height="60dp">
                            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/tryon" android:scaleType="centerCrop" android:contentDescription="@null" />
                            <View android:id="@+id/scanning_line" android:layout_width="match_parent" android:layout_height="2dp" android:background="#00FF00" android:visibility="invisible" />
                        </FrameLayout>
                        <LinearLayout android:orientation="vertical" android:layout_marginStart="16dp" android:layout_width="wrap_content" android:layout_height="wrap_content">
                            <TextView android:text="@string/title_virtual_tryon" android:textColor="@color/brand_dark_teal" android:textSize="16sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                            <TextView android:text="@string/subtitle_virtual_tryon" android:textColor="#666666" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_my_orders"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="#F8F9FA"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E0E0E0">
                    <LinearLayout android:orientation="horizontal" android:padding="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                        <ImageView android:layout_width="60dp" android:layout_height="60dp" android:src="@drawable/orders" android:scaleType="centerInside" android:contentDescription="@null" />
                        <LinearLayout android:orientation="vertical" android:layout_marginStart="16dp" android:layout_width="wrap_content" android:layout_height="wrap_content">
                            <TextView android:text="@string/title_my_orders" android:textColor="@color/brand_dark_teal" android:textSize="16sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                            <TextView android:text="@string/subtitle_my_orders" android:textColor="#666666" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_find_store"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="#F8F9FA"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E0E0E0">
                    <LinearLayout android:orientation="horizontal" android:padding="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                        <ImageView android:layout_width="60dp" android:layout_height="60dp" android:src="@drawable/ic_search" android:scaleType="centerInside" app:tint="@color/brand_dark_teal" android:contentDescription="@null" />
                        <LinearLayout android:orientation="vertical" android:layout_marginStart="16dp" android:layout_width="wrap_content" android:layout_height="wrap_content">
                            <TextView android:text="@string/title_find_store" android:textColor="@color/brand_dark_teal" android:textSize="16sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                            <TextView android:text="@string/subtitle_find_store" android:textColor="#666666" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Floating Action Menu Backdrop -->
    <View
        android:id="@+id/fab_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone"
        android:elevation="10dp" />

    <!-- AI Assistant Option -->
    <LinearLayout
        android:id="@+id/layout_ai"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone"
        android:elevation="12dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@+id/layout_post"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/category_bg_selected"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="@string/opt_ai_assistant"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:layout_marginEnd="8dp"/>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_ai"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:fabSize="mini"
            app:srcCompat="@drawable/ic_ai"
            app:backgroundTint="@color/brand_dark_teal"
            app:tint="#FFFFFF"
            android:contentDescription="@string/opt_ai_assistant" />
    </LinearLayout>

    <!-- Post Option -->
    <LinearLayout
        android:id="@+id/layout_post"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone"
        android:elevation="12dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@+id/layout_feedback"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/category_bg_selected"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="@string/opt_post"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:layout_marginEnd="8dp"/>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_post"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:fabSize="mini"
            app:srcCompat="@drawable/ic_post"
            app:backgroundTint="@color/brand_dark_teal"
            app:tint="#FFFFFF"
            android:contentDescription="@string/opt_post" />
    </LinearLayout>

    <!-- Feedback Option -->
    <LinearLayout
        android:id="@+id/layout_feedback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone"
        android:elevation="12dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@+id/fab_main"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/category_bg_selected"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="@string/opt_feedback"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:layout_marginEnd="8dp"/>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_feedback"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:fabSize="mini"
            app:srcCompat="@drawable/ic_feedback"
            app:backgroundTint="@color/brand_dark_teal"
            app:tint="#FFFFFF"
            android:contentDescription="@string/opt_feedback" />
    </LinearLayout>

    <!-- Main FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_main"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        app:srcCompat="@drawable/ic_plus"
        app:backgroundTint="@color/brand_dark_teal"
        app:tint="#FFFFFF"
        app:layout_constraintBottom_toTopOf="@+id/bottom_navigation_bar"
        app:layout_constraintEnd_toEndOf="parent"
        android:elevation="15dp"
        android:contentDescription="Menu" />

    <!-- Bottom Navigation Bar (Light Theme) -->
    <LinearLayout
        android:id="@+id/bottom_navigation_bar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@color/white"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Tab 1: Home (SELECTED) -->
        <LinearLayout
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/category_bg_selected"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="8dp">

            <ImageView
                android:id="@+id/icon_nav_home"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Home"
                android:src="@drawable/ic_home"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/text_nav_home"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Home"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tab 2: Offers -->
        <LinearLayout
            android:id="@+id/nav_offers"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/icon_nav_offers"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Offers"
                android:src="@drawable/ic_sparkle"
                app:tint="#666666" />

            <TextView
                android:id="@+id/text_nav_offers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Offers"
                android:textColor="#666666"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Tab 3: Orders -->
        <LinearLayout
            android:id="@+id/nav_orders"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/icon_nav_orders"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Orders"
                android:src="@drawable/orders"
                app:tint="#666666" />

            <TextView
                android:id="@+id/text_nav_orders"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Orders"
                android:textColor="#666666"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Tab 4: Profile -->
        <LinearLayout
            android:id="@+id/nav_profile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/icon_nav_profile"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Profile"
                android:src="@drawable/ic_person"
                app:tint="#666666" />

            <TextView
                android:id="@+id/text_nav_profile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Profile"
                android:textColor="#666666"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

