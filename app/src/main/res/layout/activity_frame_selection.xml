<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".FrameSelectionActivity">

    <!-- Top Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/white"
        app:layout_constraintTop_toTopOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_home"
                app:tint="@color/brand_dark_teal"
                android:contentDescription="Back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="@string/label_eyewear_hub"
                android:textColor="@color/brand_dark_teal"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageButton
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="16dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_person"
                app:tint="@color/brand_dark_teal"
                android:contentDescription="Profile" />
        </RelativeLayout>
    </androidx.appcompat.widget.Toolbar>

    <ScrollView
        android:id="@+id/main_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottom_navigation"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_customize_hub"
                android:textColor="@color/brand_dark_teal"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- Main Preview Image Container -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/main_frame_preview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="0dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/glass1" />

                    <!-- Zoom and Rotate Controls Overlay -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:layout_alignParentEnd="true"
                        android:layout_margin="16dp"
                        android:orientation="vertical">

                        <com.google.android.material.floatingactionbutton.FloatingActionButton
                            android:id="@+id/btn_rotate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            app:fabSize="mini"
                            app:srcCompat="@drawable/ic_rotate"
                            app:backgroundTint="@color/white"
                            app:tint="@color/brand_dark_teal"
                            android:contentDescription="Rotate" />

                        <com.google.android.material.floatingactionbutton.FloatingActionButton
                            android:id="@+id/btn_zoom_in"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            app:fabSize="mini"
                            app:srcCompat="@drawable/ic_zoom_in"
                            app:backgroundTint="@color/white"
                            app:tint="@color/brand_dark_teal"
                            android:contentDescription="Zoom In" />

                        <com.google.android.material.floatingactionbutton.FloatingActionButton
                            android:id="@+id/btn_zoom_out"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:fabSize="mini"
                            app:srcCompat="@drawable/ic_zoom_out"
                            app:backgroundTint="@color/white"
                            app:tint="@color/brand_dark_teal"
                            android:contentDescription="Zoom Out" />
                    </LinearLayout>
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/label_select_frame_type"
                android:textColor="@color/brand_dark_teal"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Horizontal Frames Selection -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Frame 1: Square -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/frame_square"
                        android:layout_width="120dp"
                        android:layout_height="140dp"
                        android:layout_marginEnd="12dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="2dp"
                        app:strokeColor="@color/brand_medium_teal"
                        app:strokeWidth="2dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="8dp">

                            <ImageView
                                android:id="@+id/check_square"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_alignParentEnd="true"
                                android:src="@drawable/ic_check_circle"
                                android:contentDescription="Selected" />

                            <ImageView
                                android:id="@+id/thumb_square"
                                android:layout_width="match_parent"
                                android:layout_height="80dp"
                                android:layout_centerInParent="true"
                                android:src="@drawable/square"
                                android:scaleType="centerInside" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_alignParentBottom="true"
                                android:gravity="center"
                                android:text="SQUARE"
                                android:textColor="@color/brand_dark_teal"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </RelativeLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Frame 2: Tortoiseshell -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/frame_tortoise"
                        android:layout_width="120dp"
                        android:layout_height="140dp"
                        android:layout_marginEnd="12dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="2dp"
                        app:strokeWidth="0dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="8dp">

                            <ImageView
                                android:id="@+id/check_tortoise"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_alignParentEnd="true"
                                android:src="@drawable/ic_check_circle"
                                android:visibility="gone"
                                android:contentDescription="Selected" />

                            <ImageView
                                android:id="@+id/thumb_tortoise"
                                android:layout_width="match_parent"
                                android:layout_height="80dp"
                                android:layout_centerInParent="true"
                                android:src="@drawable/tortoiseshell"
                                android:scaleType="centerInside" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_alignParentBottom="true"
                                android:gravity="center"
                                android:text="TORTOISESHELL"
                                android:textColor="@color/brand_dark_teal"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </RelativeLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Frame 3: Aviator -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/frame_aviator"
                        android:layout_width="120dp"
                        android:layout_height="140dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="2dp"
                        app:strokeWidth="0dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="8dp">

                            <ImageView
                                android:id="@+id/check_aviator"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_alignParentEnd="true"
                                android:src="@drawable/ic_check_circle"
                                android:visibility="gone"
                                android:contentDescription="Selected" />

                            <ImageView
                                android:id="@+id/thumb_aviator"
                                android:layout_width="match_parent"
                                android:layout_height="80dp"
                                android:layout_centerInParent="true"
                                android:src="@drawable/aviator"
                                android:scaleType="centerInside" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_alignParentBottom="true"
                                android:gravity="center"
                                android:text="AVIATOR"
                                android:textColor="@color/brand_dark_teal"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </RelativeLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/label_select_frame_color"
                android:textColor="@color/brand_dark_teal"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Horizontal Colors Selection -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Color 1: Black -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/color_black"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="12dp"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="2dp"
                        app:strokeColor="@color/brand_medium_teal"
                        app:strokeWidth="2dp">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#212121" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Color 2: Tortoiseshell -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/color_tortoise"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="12dp"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="2dp"
                        app:strokeWidth="0dp">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#8B4513" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Color 3: Gray -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/color_gray"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="12dp"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="2dp"
                        app:strokeWidth="0dp">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#9E9E9E" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Color 4: Gold -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/color_gold"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="12dp"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="2dp"
                        app:strokeWidth="0dp">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#FFD700" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Color 5: Silver -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/color_silver"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="2dp"
                        app:strokeWidth="0dp">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#E0E0E0" />
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_frame_material"
                    android:textColor="@color/brand_dark_teal"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinner_material"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/search_bg"
                    android:padding="8dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:itemIconTint="@color/brand_dark_teal"
        app:itemTextColor="@color/brand_dark_teal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:menu="@menu/bottom_nav_menu" />

</androidx.constraintlayout.widget.ConstraintLayout>
